# ==============================================================================
# CivixPay - Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your actual values.
# Get Supabase keys from: https://app.supabase.com/project/_/settings/api
# ==============================================================================

# ---- SUPABASE (REQUIRED) ----
# Your project URL: https://app.supabase.com -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) key - safe to expose in client, enforced by RLS
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---- OPTIONAL ----
# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# Analytics
VITE_ANALYTICS_ID=

